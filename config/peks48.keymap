#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Conversion definition for using Japanese keyboard with OS settings
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     //
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";
        
        // 左下(36) + 右下(47) + 左上(0)の3点同時押しでBluetooth全リセット
        combo_bt_clr {
            timeout-ms = <50>;
            key-positions = <36 47 0>;
            bindings = <&bt BT_CLR_ALL>;
        };
        
        // 左下(36) + 右下(47) + 左手人差し指上(5)の3点同時押しでシステムリセット
        combo_sys_reset {
            timeout-ms = <50>;
            key-positions = <36 47 5>;
            bindings = <&sys_reset>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp TAB       &kp Q    &kp W    &kp E     &kp R     &kp T          &kp Y     &kp U    &kp I     &kp O   &kp P    &kp BSPC
                &mt LCTRL ESC &kp A    &kp S    &kp D     &kp F     &kp G          &kp H     &kp J    &kp K     &kp L   &kp SEMI &kp SQT
                &kp LSHFT     &kp Z    &kp X    &kp C     &kp V     &kp B          &kp N     &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                &kp LGUI      &kp LALT &trans   &mo 1     &kp SPACE &mo 3          &mo 2     &kp RET  &mo 1     &trans  &kp RALT &kp RCTRL
            >;
        };

        nav_layer {
            bindings = <
                &kp ESC       &kp F1   &kp F2   &kp F3    &kp F4    &kp F5         &kp PG_UP &kp HOME &kp UP   &kp END   &kp C_VOL_UP &kp C_MUTE
                &kp LGUI      &kp LALT &kp LCTRL &kp LSHFT &kp F6    &trans         &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &kp C_VOL_DN &trans
                &trans        &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &trans         &trans    &trans   &trans   &trans    &trans       &trans
                &trans        &trans   &trans   &trans    &trans    &trans         &trans    &trans   &trans   &trans    &trans       &trans
            >;
        };

        num_layer {
            bindings = <
                &kp F7        &kp F8   &kp F9   &kp F10   &kp F11   &kp F12        &kp EQUAL &kp N7   &kp N8   &kp N9    &kp DEL      &trans
                &trans        &trans   &trans   &trans    &trans    &trans         &kp MINUS &kp N4   &kp N5   &kp N6    &kp PLUS     &trans
                &trans        &trans   &trans   &trans    &trans    &trans         &kp STAR  &kp N1   &kp N2   &kp N3    &kp FSLH     &trans
                &trans        &trans   &trans   &trans    &trans    &trans         &kp N0    &kp N0   &kp DOT  &kp RET   &trans       &trans
            >;
        };

        sym_layer {
            bindings = <
                &kp EXCL      &kp AT   &kp HASH &kp DLLR  &kp PRCNT &kp CARET      &kp AMPS  &kp LBKT &kp RBKT &kp UNDER &kp BSLH     &bt BT_PRV
                &kp GRAVE     &kp TILDE &trans  &trans    &trans    &trans         &trans    &kp LPAR &kp RPAR &kp MINUS &kp EQUAL    &bt BT_NXT
                &trans        &trans   &trans   &trans    &trans    &trans         &trans    &kp LBRC &kp RBRC &trans    &trans       &kp LS(LG(S))
                &trans        &trans   &trans   &trans    &trans    &trans         &trans    &trans   &trans   &trans    &trans       &trans
            >;
        };
    };
};
