#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = ;
};

/ {
    behaviors {
        // Shift + Backspace で Delete になる設定
        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = ;
            bindings = <&kp BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_bt_clr {
            timeout-ms = ;
            key-positions = <36 47 0>;
            bindings = <&bt BT_CLR_ALL>;
        };

        combo_sys_reset {
            timeout-ms = ;
            key-positions = <36 47 5>;
            bindings = <&sys_reset>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp Q     &kp W     &kp E     &kp R     &kp T          &kp Y      &kp U     &kp I      &kp O    &kp P      &bspc_del
&kp TAB    &kp A     &kp S     &kp D     &kp F     &kp G          &kp H      &kp J     &kp K      &kp L    &kp SEMI   &kp SQT
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V     &kp B          &kp N      &kp M     &kp COMMA  &kp DOT  &kp MINUS  &kp FSLH
&kp LCTRL  &kp LALT  &kp LGUI  &kp INT5  &mo 2     &lt 1 SPACE    &lt 3 RET  &kp INT4  &trans     &trans   &kp RALT   &kp RSHFT
            >;
        };

        nav_layer {
            bindings = <
&trans  &kp N1     &kp N2          &kp N3          &kp N4           &kp N5       &kp N6     &kp N7  &kp N8    &kp N9           &kp N0  &trans
&trans  &trans     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans       &kp PG_UP  &none   &kp UP    &none            &none   &kp C_MUTE
&trans  &kp LC(Z)  &kp LC(X)       &kp LC(C)       &kp LC(V)        &trans       &kp PG_DN  &kp LEFT &kp DOWN &kp RIGHT_ARROW  &none   &kp C_VOL_UP
&trans  &trans     &trans          &trans          &trans           &trans       &trans     &trans  &trans    &trans           &trans  &kp C_VOL_DN
            >;
        };

        num_layer {
            bindings = <
&trans    &kp N1    &kp N2    &kp N3        &kp N4     &kp N5       &kp N6     &kp N7  &kp N8   &kp N9   &kp N0     &kp BSPC
&kp EXCL  &kp AT    &kp HASH  &kp DLLR      &kp PRCNT  &kp CARET    &kp UNDER  &kp N4  &kp N5   &kp N6   &kp COLON  &trans
&kp STAR  &kp LPAR  &kp RBKT  &kp BSLH      &kp RBRC   &kp PIPE     &kp MINUS  &kp N1  &kp N2   &kp N3   &kp DQT    &kp EQUAL
&trans    &kp LBKT  &none     &kp LS(INT1)  &none      &kp LBRC     &kp PLUS   &kp N0  &kp DOT  &kp RET  &kp FSLH   &trans
            >;
        };

        sys_layer {
            bindings = <
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5  &kp F6    &kp F7      &kp F8  &kp F9  &kp F10      &kp F11  &kp F12
&trans        &trans        &trans        &trans        &trans  &trans    &trans      &trans  &trans  &trans       &trans   &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR    &trans  &trans    &trans      &trans  &trans  &trans       &trans   &trans
&trans        &trans        &trans        &bootloader   &trans  &trans    &kp LA(F4)  &trans  &trans  &bootloader  &trans   &kp LS(LG(S))
            >;
        };
    };
};
